// ==UserScript==
// @name         Tensor.Art - NSFW Bypass (via TensorHub)
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Automatically redirects NSFW generation requests from tensor.art to tensorhub.art API, using tensor.art credits
// @author       You
// @match        https://tensor.art/*
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        unsafeWindow
// @connect      api.tensorhub.art
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    const W = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
    const _realFetch = W.fetch.bind(W);

    const BLOCKED_HEADERS = ['priority', 'sec-ch-ua', 'sec-ch-ua-mobile', 'sec-ch-ua-platform'];
    const TASK_ENDPOINT = '/works/v1/works/task';
    const SENSITIVE_CHECK_ENDPOINT = '/sensitive/words/check';
    const TENSORHUB_TASK_URL = 'https://api.tensorhub.art/works/v1/works/task';

    // ══════════════════════════════════════════════════════════════
    //  State — persist captured headers across page loads
    // ══════════════════════════════════════════════════════════════
    let capturedHeaders = GM_getValue('capturedHeaders', null);
    let capturedAt = GM_getValue('capturedAt', 0);
    const HEADER_MAX_AGE_MS = 30 * 60 * 1000; // 30 minutes — refresh if older

    function headersValid() {
        if (!capturedHeaders) return false;
        if (!capturedHeaders['Authorization'] && !capturedHeaders['authorization']) return false;
        if (Date.now() - capturedAt > HEADER_MAX_AGE_MS) return false;
        return true;
    }

    function saveHeaders(h) {
        capturedHeaders = h;
        capturedAt = Date.now();
        GM_setValue('capturedHeaders', h);
        GM_setValue('capturedAt', capturedAt);
    }

    console.log('[NSFW-Bypass] Initializing...');
    if (headersValid()) {
        console.log('[NSFW-Bypass] ✓ Restored saved headers (age: ' + Math.round((Date.now() - capturedAt) / 1000) + 's)');
    }

    // ══════════════════════════════════════════════════════════════
    //  Intercept fetch
    // ══════════════════════════════════════════════════════════════
    W.fetch = function (input, init) {
        const url = typeof input === 'string' ? input : input?.url || '';

        // ── Capture headers from all API calls ──
        if (url.includes('api.tensor.art') && init?.headers) {
            const h = {};
            if (init.headers instanceof W.Headers) {
                init.headers.forEach((v, k) => { h[k] = v; });
            } else if (typeof init.headers === 'object') {
                Object.assign(h, init.headers);
            }
            // Only save if it has auth
            if (h['Authorization'] || h['authorization']) {
                saveHeaders(h);
            }
        }

        // ── Bypass: fake the sensitive word check to always return clean ──
        if (url.includes(SENSITIVE_CHECK_ENDPOINT)) {
            console.log('[NSFW-Bypass] Intercepted sensitive word check → returning clean');
            return Promise.resolve(new Response(JSON.stringify({
                code: '0000',
                data: { hasSensitiveWord: false, sensitiveWords: [] },
                message: ''
            }), {
                status: 200,
                headers: { 'Content-Type': 'application/json' }
            }));
        }

        // ── Redirect: generation requests with NSFW content → tensorhub ──
        if (url.includes(TASK_ENDPOINT) && !url.includes('tasks/query') && init?.method?.toUpperCase() === 'POST') {
            let bodyStr = init.body;
            let bodyObj;
            try {
                bodyObj = JSON.parse(bodyStr);
            } catch (e) {
                // Not a JSON body or not the task creation endpoint, pass through
                return _realFetch(input, init);
            }

            // Only redirect if the body has a params.prompt field (actual generation, not query)
            if (!bodyObj?.params?.prompt) {
                return _realFetch(input, init);
            }

            const prompt = bodyObj.params.prompt;
            console.log('[NSFW-Bypass] Intercepted generation request');
            console.log('[NSFW-Bypass]   Prompt:', prompt.substring(0, 80) + (prompt.length > 80 ? '...' : ''));

            // Always redirect through tensorhub — safe prompts work fine there too
            return redirectToHub(init, bodyStr);
        }

        return _realFetch(input, init);
    };

    // ══════════════════════════════════════════════════════════════
    //  Redirect generation to tensorhub.art API
    // ══════════════════════════════════════════════════════════════
    function redirectToHub(init, bodyStr) {
        // Use headers from THIS specific request (they have a fresh HMAC signature)
        const reqHeaders = {};
        if (init.headers instanceof W.Headers) {
            init.headers.forEach((v, k) => { reqHeaders[k] = v; });
        } else if (typeof init.headers === 'object') {
            Object.assign(reqHeaders, init.headers);
        }

        // Build clean header set
        const headers = {};
        for (const [k, v] of Object.entries(reqHeaders)) {
            if (BLOCKED_HEADERS.includes(k.toLowerCase())) continue;
            headers[k] = v;
        }
        // Swap package ID to tensorhub
        headers['X-Request-Package-Id'] = '3003';
        headers['Content-Type'] = 'application/json';

        console.log('[NSFW-Bypass] → Redirecting to api.tensorhub.art (Package-Id: 3003)');

        return new Promise((resolve) => {
            GM_xmlhttpRequest({
                method: 'POST',
                url: TENSORHUB_TASK_URL,
                headers: headers,
                data: bodyStr,
                onload: function (resp) {
                    console.log('[NSFW-Bypass] ← Response:', resp.status);
                    try {
                        const data = JSON.parse(resp.responseText);
                        if (data.code === '0' || data.code === '0000') {
                            console.log('[NSFW-Bypass] ✅ Task created! ID:', data.data?.task?.taskId);
                            // Return as a normal Response so the UI handles it
                            resolve(new Response(resp.responseText, {
                                status: 200,
                                headers: { 'Content-Type': 'application/json' }
                            }));
                        } else {
                            console.warn('[NSFW-Bypass] ⚠️ Server returned error:', data.code, data.msg || data.message);
                            // If headers expired, clear them so user knows to refresh
                            if (data.code === 20000 || resp.status === 405) {
                                console.error('[NSFW-Bypass] Headers may have expired. Generate a safe image to refresh.');
                            }
                            resolve(new Response(resp.responseText, {
                                status: resp.status,
                                headers: { 'Content-Type': 'application/json' }
                            }));
                        }
                    } catch (e) {
                        resolve(new Response(resp.responseText, {
                            status: resp.status,
                            headers: { 'Content-Type': 'application/json' }
                        }));
                    }
                },
                onerror: function (err) {
                    console.error('[NSFW-Bypass] ❌ Request failed:', err);
                    resolve(new Response(JSON.stringify({
                        code: 'BYPASS_ERROR',
                        msg: 'NSFW bypass request failed. Try generating a safe image first to refresh headers.'
                    }), {
                        status: 500,
                        headers: { 'Content-Type': 'application/json' }
                    }));
                }
            });
        });
    }

    // ══════════════════════════════════════════════════════════════
    //  Console API
    // ══════════════════════════════════════════════════════════════
    W.NSFWBypass = {
        /** Check status of captured headers */
        status: () => {
            console.log('[NSFW-Bypass] Headers captured:', !!capturedHeaders);
            console.log('[NSFW-Bypass] Headers age:', capturedHeaders ? Math.round((Date.now() - capturedAt) / 1000) + 's' : 'N/A');
            console.log('[NSFW-Bypass] Headers valid:', headersValid());
            return { hasCaptured: !!capturedHeaders, age: Date.now() - capturedAt, valid: headersValid() };
        },

        /** Clear saved headers */
        clearHeaders: () => {
            capturedHeaders = null;
            capturedAt = 0;
            GM_setValue('capturedHeaders', null);
            GM_setValue('capturedAt', 0);
            console.log('[NSFW-Bypass] Headers cleared.');
        },

        /** Enable/disable the bypass (default: enabled) */
        enabled: true,
    };

    console.log('[NSFW-Bypass] ✓ Ready. All generation requests will be routed through tensorhub.art.');
    console.log('[NSFW-Bypass]   Just type your prompt (including NSFW) and click Generate normally.');
    console.log('[NSFW-Bypass]   Console: NSFWBypass.status()  |  NSFWBypass.clearHeaders()');
})();
