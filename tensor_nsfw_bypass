// ==UserScript==
// @name         Tensor.Art - NSFW Bypass (via TensorHub)
// @namespace    tensor-nsfw-bypass
// @version      3.3
// @description  Routes generation requests through tensorhub.art API, bypassing NSFW prompt filter while using tensor.art credits
// @author       You
// @match        https://tensor.art/*
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        unsafeWindow
// @connect      api.tensorhub.art
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    const W = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
    const _realFetch = W.fetch.bind(W);
    const BLOCKED_HEADERS = ['priority', 'sec-ch-ua', 'sec-ch-ua-mobile', 'sec-ch-ua-platform'];
    const TENSORHUB_TASK_URL = 'https://api.tensorhub.art/works/v1/works/task';

    // ══════════════════════════════════════════════════════════════
    //  Always-on — no toggle needed
    // ══════════════════════════════════════════════════════════════
    let bypassEnabled = true;

    // ══════════════════════════════════════════════════════════════
    //  Fetch interception
    // ══════════════════════════════════════════════════════════════
    W.fetch = function (input, init) {
        const url = typeof input === 'string' ? input : input?.url || '';

        // Only intercept when bypass is enabled
        if (!bypassEnabled) return _realFetch(input, init);

        // ── Bypass sensitive word check: pass through but patch the result ──
        if (url.includes('/sensitive/words/check')) {
            return _realFetch(input, init).then(async (response) => {
                try {
                    const data = await response.clone().json();
                    if (data.data) {
                        data.data.hasSensitiveWord = false;
                        data.data.sensitiveWords = [];
                    }
                    return new Response(JSON.stringify(data), {
                        status: response.status,
                        statusText: response.statusText,
                        headers: { 'Content-Type': 'application/json' }
                    });
                } catch (e) {
                    return response;
                }
            });
        }

        // ── Redirect generation request to tensorhub ──
        // EXACT match: only /works/v1/works/task (end of path)
        if (/\/works\/v1\/works\/task(\?|$)/.test(url) &&
            init?.method?.toUpperCase() === 'POST') {
            let bodyObj;
            try { bodyObj = JSON.parse(init.body); } catch (e) { return _realFetch(input, init); }
            if (!bodyObj?.params?.prompt) return _realFetch(input, init);

            console.log('[NSFW-Bypass] ✓ Redirecting generation to tensorhub');
            return redirectToHub(init, init.body);
        }

        return _realFetch(input, init);
    };

    // ══════════════════════════════════════════════════════════════
    //  Redirect to tensorhub
    // ══════════════════════════════════════════════════════════════
    function redirectToHub(init, bodyStr) {
        const reqHeaders = {};
        if (init.headers instanceof W.Headers) {
            init.headers.forEach((v, k) => { reqHeaders[k] = v; });
        } else if (typeof init.headers === 'object') {
            Object.assign(reqHeaders, init.headers);
        }

        const headers = {};
        for (const [k, v] of Object.entries(reqHeaders)) {
            if (BLOCKED_HEADERS.includes(k.toLowerCase())) continue;
            headers[k] = v;
        }
        headers['X-Request-Package-Id'] = '3003';
        headers['Content-Type'] = 'application/json';

        return new Promise((resolve) => {
            GM_xmlhttpRequest({
                method: 'POST',
                url: TENSORHUB_TASK_URL,
                headers: headers,
                data: bodyStr,
                onload: function (resp) {
                    try {
                        const data = JSON.parse(resp.responseText);
                        if (data.code === '0' || data.code === '0000') {
                            console.log('[NSFW-Bypass] ✅ Task created:', data.data?.task?.taskId);
                        } else {
                            console.warn('[NSFW-Bypass] ⚠️ Error:', data.code, data.msg || data.message);
                        }
                    } catch (e) { /* pass raw */ }
                    resolve(new Response(resp.responseText, {
                        status: 200,
                        headers: { 'Content-Type': 'application/json' }
                    }));
                },
                onerror: function (err) {
                    console.error('[NSFW-Bypass] ❌ Failed:', err);
                    resolve(new Response(JSON.stringify({ code: 'ERROR', msg: 'Bypass failed' }), {
                        status: 500, headers: { 'Content-Type': 'application/json' }
                    }));
                }
            });
        });
    }

    // ══════════════════════════════════════════════════════════════
    //  Console API
    // ══════════════════════════════════════════════════════════════
    W.NSFWBypass = {
        on: () => { bypassEnabled = true; console.log('[NSFW-Bypass] ON'); },
        off: () => { bypassEnabled = false; console.log('[NSFW-Bypass] OFF'); },
        status: () => ({ enabled: bypassEnabled }),
    };

    console.log('[NSFW-Bypass v3] ✓ Active. All generations routed through tensorhub.');
})();

