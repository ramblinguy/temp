// ==UserScript==
// @name         Tensor.Art - Show TensorHub Images
// @namespace    tensor-hub-merge
// @version      1.2
// @description  Fetches generation tasks from tensorhub.art and merges them into tensor.art's task list so they appear in your history
// @author       You
// @match        https://tensor.art/*
// @grant        GM_xmlhttpRequest
// @grant        unsafeWindow
// @connect      api.tensorhub.art
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    const W = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
    const _realFetch = W.fetch.bind(W);
    const BLOCKED_HEADERS = ['priority', 'sec-ch-ua', 'sec-ch-ua-mobile', 'sec-ch-ua-platform'];

    let capturedHeaders = null;

    console.log('[HubMerge] Initializing — will merge tensorhub tasks into tensor.art...');

    // ══════════════════════════════════════════════════════════════
    //  Intercept fetch
    // ══════════════════════════════════════════════════════════════
    W.fetch = function (input, init) {
        const url = typeof input === 'string' ? input : input?.url || '';

        // Capture headers from any api.tensor.art call
        if (url.includes('api.tensor.art') && init?.headers) {
            const h = {};
            if (init.headers instanceof W.Headers) {
                init.headers.forEach((v, k) => { h[k] = v; });
            } else if (typeof init.headers === 'object') {
                Object.assign(h, init.headers);
            }
            if (h['Authorization'] || h['authorization']) {
                capturedHeaders = h;
            }
        }

        // Intercept tasks/query responses to merge in tensorhub tasks
        if (url.includes('/works/v1/works/tasks/query') && url.includes('api.tensor.art')) {
            const bodyStr = init?.body;

            return _realFetch(input, init).then(async (response) => {
                try {
                    const cloned = response.clone();
                    const tensorData = await cloned.json();

                    // Fetch tensorhub tasks in parallel
                    const hubTasks = await fetchHubTasks(bodyStr);

                    if (hubTasks && hubTasks.length > 0) {
                        const merged = mergeTaskData(tensorData, hubTasks);
                        console.log(`[HubMerge] ✓ Merged ${hubTasks.length} tensorhub tasks`);

                        return new Response(JSON.stringify(merged), {
                            status: response.status,
                            statusText: response.statusText,
                            headers: { 'Content-Type': 'application/json' }
                        });
                    }
                } catch (e) {
                    console.warn('[HubMerge] Merge failed, returning original:', e.message);
                }

                return response;
            });
        }

        return _realFetch(input, init);
    };

    // ══════════════════════════════════════════════════════════════
    //  Fetch tasks from tensorhub API
    // ══════════════════════════════════════════════════════════════
    function fetchHubTasks(originalBody) {
        if (!capturedHeaders) {
            console.log('[HubMerge] No headers captured yet, skipping hub fetch');
            return Promise.resolve([]);
        }

        const headers = {};
        for (const [k, v] of Object.entries(capturedHeaders)) {
            if (BLOCKED_HEADERS.includes(k.toLowerCase())) continue;
            headers[k] = v;
        }
        headers['X-Request-Package-Id'] = '3003';
        headers['Content-Type'] = 'application/json';

        // Use the same query body as the tensor.art request
        let bodyStr = originalBody || JSON.stringify({
            cursor: '0',
            size: 30,
            returnAllTask: true,
            isSortAsc: true,
            startedAt: '0',
            endedAt: '0'
        });

        return new Promise((resolve) => {
            GM_xmlhttpRequest({
                method: 'POST',
                url: 'https://api.tensorhub.art/works/v1/works/tasks/query',
                headers: headers,
                data: bodyStr,
                onload: function (resp) {
                    try {
                        const data = JSON.parse(resp.responseText);
                        const tasks = data?.data?.tasks || data?.data?.list || [];
                        console.log(`[HubMerge] Fetched ${tasks.length} tasks from tensorhub`);
                        resolve(tasks);
                    } catch (e) {
                        console.warn('[HubMerge] Failed to parse hub response:', e.message);
                        resolve([]);
                    }
                },
                onerror: function (err) {
                    console.warn('[HubMerge] Hub fetch failed:', err);
                    resolve([]);
                }
            });
        });
    }

    // ══════════════════════════════════════════════════════════════
    //  Merge tensorhub tasks into tensor.art response
    // ══════════════════════════════════════════════════════════════
    function mergeTaskData(tensorData, hubTasks) {
        // Find where tensor.art stores its task list
        let taskList;
        if (tensorData?.data?.tasks) {
            taskList = tensorData.data.tasks;
        } else if (tensorData?.data?.list) {
            taskList = tensorData.data.list;
        } else {
            console.warn('[HubMerge] Unknown response structure, keys:', Object.keys(tensorData?.data || {}));
            return tensorData;
        }

        // Track existing task IDs to avoid duplicates
        const existingIds = new Set(taskList.map(t => t.taskId || t.id));

        // Tag hub tasks so we can identify them, and filter duplicates
        let added = 0;
        for (const task of hubTasks) {
            const id = task.taskId || task.id;
            if (id && !existingIds.has(id)) {
                task._fromHub = true; // internal tag
                taskList.push(task);
                existingIds.add(id);
                added++;
            }
        }

        // Sort by createdAt descending (newest first)
        taskList.sort((a, b) => {
            const aTime = parseInt(a.createdAt || '0');
            const bTime = parseInt(b.createdAt || '0');
            return bTime - aTime;
        });

        // Write back
        if (tensorData?.data?.tasks) {
            tensorData.data.tasks = taskList;
        } else if (tensorData?.data?.list) {
            tensorData.data.list = taskList;
        }

        console.log(`[HubMerge] Added ${added} new hub tasks (${taskList.length} total)`);
        return tensorData;
    }

    // ══════════════════════════════════════════════════════════════
    //  Status indicator
    // ══════════════════════════════════════════════════════════════
    function createUI() {
        const badge = document.createElement('div');
        badge.id = 'hubmerge-status';
        badge.style.cssText = `
            position:fixed;bottom:14px;left:14px;z-index:99997;
            padding:5px 10px;border-radius:16px;font-size:10px;font-weight:600;
            font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
            background:#1a1a3e;color:#b388ff;border:1px solid #3a2a6a;
            box-shadow:0 2px 8px rgba(0,0,0,0.3);user-select:none;
        `;
        badge.textContent = '🔄 Hub Merge ON';
        badge.title = 'TensorHub tasks will appear in your history';
        document.body.appendChild(badge);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', createUI);
    } else {
        createUI();
    }

    setInterval(() => {
        if (!document.getElementById('hubmerge-status')) createUI();
    }, 5000);

    // ══════════════════════════════════════════════════════════════
    //  Console API
    // ══════════════════════════════════════════════════════════════
    W.HubMerge = {
        status: () => ({
            hasHeaders: !!capturedHeaders,
            message: capturedHeaders ? 'Ready — hub tasks will be merged on next page load' : 'Waiting for headers...'
        }),
    };

    console.log('[HubMerge] ✓ Ready. TensorHub tasks will automatically appear in your generation history.');
})();
